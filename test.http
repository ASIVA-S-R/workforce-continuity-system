### =====================================================
### WORKFORCE CONTINUITY SYSTEM - TEST HTTP
### =====================================================


### =====================================================
### 1. EMPLOYEE LOGIN
### =====================================================

POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "employee1",
  "password": "123456"
}

> {%
    client.global.set("employeeToken", response.body.token);
%}


### =====================================================
### 2. MANAGER LOGIN
### =====================================================

POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "manager1",
  "password": "123456"
}

> {%
    client.global.set("managerToken", response.body.token);
%}


### =====================================================
### 3. EMPLOYEE MANAGEMENT
### =====================================================

### Get All Employees
GET http://localhost:8080/api/employees
Authorization: Bearer {{managerToken}}


### Get Employee 2
GET http://localhost:8080/api/employees/2
Authorization: Bearer {{managerToken}}


### Employee Dashboard
GET http://localhost:8080/api/employees/2/dashboard
Authorization: Bearer {{managerToken}}


### Create Employee
POST http://localhost:8080/api/employees
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Test Employee",
  "email": "testemployee@example.com",
  "role": "Employee",
  "departmentId": 1,
  "critical": false
}


### Update Employee 2
PUT http://localhost:8080/api/employees/2
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Asiva SR",
  "email": "asiva@example.com",
  "role": "Employee",
  "departmentId": 1,
  "critical": true
}


### =====================================================
### 4. LEAVE BALANCE
### =====================================================

### Get Employee 2 Leave Balance
GET http://localhost:8080/api/leave-balances/2
Authorization: Bearer {{managerToken}}


### Create Employee 2 Leave Balance
POST http://localhost:8080/api/leave-balances/2
Authorization: Bearer {{managerToken}}


### =====================================================
### 5. LEAVES
### =====================================================

### Get All Leaves
GET http://localhost:8080/api/leaves
Authorization: Bearer {{managerToken}}


### Get Leave By ID
GET http://localhost:8080/api/leaves/10
Authorization: Bearer {{managerToken}}


### Create Leave
POST http://localhost:8080/api/leaves
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "employeeId": 2,
  "leaveType": "Casual",
  "startDate": "2026-09-25",
  "endDate": "2026-09-26",
  "reason": "Personal work"
}


### Update Leave
PUT http://localhost:8080/api/leaves/10
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "employeeId": 2,
  "leaveType": "Casual",
  "startDate": "2026-10-01",
  "endDate": "2026-10-02",
  "reason": "Personal work",
  "status": "PENDING"
}


### Delete Leave
DELETE http://localhost:8080/api/leaves/10
Authorization: Bearer {{employeeToken}}


### =====================================================
### 6. MANAGER LEAVE APPROVAL
### =====================================================

### Approve Leave 10
PUT http://localhost:8080/api/leaves/10/approve
Authorization: Bearer {{managerToken}}


### Reject Leave 10
PUT http://localhost:8080/api/leaves/10/reject
Authorization: Bearer {{managerToken}}


### =====================================================
### 7. WORKFORCE STATUS
### =====================================================

### Get Employee 2 Status
GET http://localhost:8080/api/workforce/status/2
Authorization: Bearer {{managerToken}}


### Get All Workforce Status
GET http://localhost:8080/api/workforce/status
Authorization: Bearer {{managerToken}}


### Get Available Employees
GET http://localhost:8080/api/workforce/available
Authorization: Bearer {{managerToken}}


### Get Unavailable Employees
GET http://localhost:8080/api/workforce/unavailable
Authorization: Bearer {{managerToken}}


### Get Department Workforce Status
GET http://localhost:8080/api/workforce/department/1
Authorization: Bearer {{managerToken}}


### Update Employee Workforce Status
PUT http://localhost:8080/api/workforce/status/2
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "status": "WORKING",
  "availability": "AVAILABLE"
}


